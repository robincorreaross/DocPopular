# .env.example - Configurações de Ambiente (Modelo)
# Renomeie este arquivo para .env localmente e preencha com suas chaves.
# ATENÇÃO: Nunca envie o arquivo .env real para o GitHub.

# OpenAI (Visão de Documentos)
OPENAI_API_KEY="sk-..."

# Configurações do Supabase para Licenciamento (Anon Key é aceitável, mas prefira armazenar aqui para facilitar a rotação)
SUPABASE_URL="https://[PROJECT-ID].supabase.co"
SUPABASE_KEY="eyJhb...[ANON-JWT]"
SUPABASE_TABLE="doc_popular"

# Licenciamento Próprio (Geração de Chaves HMAC) - EXTREMAMENTE SECRETO
LICENSE_SECRET_KEY="SUA_CHAVE_SECRETA_MUUUUITO_SEGURA"
